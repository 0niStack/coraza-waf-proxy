# Copy this to .env and adjust as needed:
#   cp .env.example .env
#
# Where the WAF (Caddy) sends clean traffic after inspection.
#
#   An app running directly on the VM host (outside Docker) — default:
#     UPSTREAM=host.docker.internal:5000
#
#   A container on this compose network (add it to docker-compose.yml first):
#     UPSTREAM=my-app:8000
#
#   Any other reachable host/IP:
#     UPSTREAM=192.168.1.50:8080

UPSTREAM=host.docker.internal:5000
